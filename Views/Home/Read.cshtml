@model IEnumerable<LibraryManagement.Models.Book>
@addTagHelper "*, Microsoft.AspNetCore.Mvc.TagHelpers"

@{
    ViewData["Title"] = "Book List";
}
<html>
    <head>
    <meta name="viewport" content="width=device-width" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
</head>
    <body class="p-4">
<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill me-2"></i>Library Book Management</h2>
        <a asp-action="create" class="btn btn-primary"> 
            <i class="bi bi-person-plus-fill me-1"></i>
            Add New Book

        </a>
    </div>

    <!-- Search Bar Form -->
<div class="row mb-4">
        <div class="col-md-8 mx-auto">
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" 
                       id="searchInput" 
                       class="form-control border-start-0 ps-0" 
                       placeholder="Type to search instantly by title, author, category, or publisher..." 
                       autocomplete="off" />
                <button class="btn btn-outline-secondary" type="button" id="clearBtn" style="display: none;">
                    Clear
                </button>
            </div>
        </div>
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
    <table class="table table-striped table-hover align-middle mb-0" id="booksTable">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Book Name</th>
                <th>Author</th>
                <th>Publisher</th>
                <th>Category</th>
                <th>Quantity</th>
                <th>Available</th>
                <th>Price</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var book in Model)
                {
                    <tr>
                        <td>@book.BookId</td>
                        <td>@book.BookName</td>
                        <td>@book.Author</td>
                        <td>@book.Publisher</td>
                        <td>@book.Category</td>
                        <td>@book.Quantity</td>
                        <td>@book.AvailableCopies</td>
                        <td>@book.Price</td>
                        <td class="text-center">
    <div class="btn-group" role="group">
        <!-- Borrow Button -->
        @if (book.AvailableCopies > 0)
        {
            <form asp-action="Borrow" asp-route-id="@book.BookId" method="post" class="d-inline me-1">
                <button type="submit" class="btn btn-outline-success btn-sm" title="Borrow">
                    <i class="bi bi-journal-arrow-down"></i>
                </button>
            </form>
        }
        else
        {
            <button type="button" class="btn btn-outline-secondary btn-sm me-1" disabled title="Out of Stock">
                <i class="bi bi-journal-x"></i>
            </button>
        }

        <!-- Return Button -->
        <form asp-action="Return" asp-route-id="@book.BookId" method="post" class="d-inline me-1">
            <button type="submit" class="btn btn-outline-warning btn-sm" title="Return">
                <i class="bi bi-journal-arrow-up"></i>
            </button>
        </form>

        <!-- Edit Icon/Button -->
        <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-outline-primary btn-sm me-1" title="Edit">
            <i class="bi bi-pencil-square"></i>
        </a>

        <!-- Delete Icon/Button (Using POST form for security) -->
        <form asp-action="Delete" asp-route-id="@book.BookId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this book?');">
            <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete">
                <i class="bi bi-trash"></i>
            </button>
        </form>
    </div>
</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center">No books found in the library.</td>
                </tr>
            }
        </tbody>
    </table>
    <div id="noResults" class="text-center py-4 text-muted" style="display: none;">
                    <i class="bi bi-search fs-3 d-block mb-2"></i>
                    No matching books found.
                </div>
    </div>
    </div>
    </div>


    
        <script>
            const searchInput = document.getElementById('searchInput');
        const clearBtn = document.getElementById('clearBtn');
        const table = document.getElementById('booksTable');
        const rows = table.querySelectorAll('tbody tr');
        const noResults = document.getElementById('noResults');

        searchInput.addEventListener('keyup', function() {
            const query = searchInput.value.toLowerCase().trim();
            let visibleCount = 0;

            // Show/hide clear button
            clearBtn.style.display = query.length > 0 ? 'block' : 'none';

            rows.forEach(row => {
                    // Skip the "No books found" initial row if present
                    if (row.cells.length === 1) return;

                    const text = row.textContent.toLowerCase();
                    if (text.includes(query)) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

            // Show or hide "No results" message
            noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        });

        clearBtn.addEventListener('click', function() {
            searchInput.value = '';
            clearBtn.style.display = 'none';
            rows.forEach(row => row.style.display = '');
            noResults.style.display = 'none';
            searchInput.focus();
        });
        </script>
    
</div>

                            </body>
</html>